{
  "manifest_version": 3,
  "name": "신재생에너지센터 자동입력·크롤링",
  "description": "nr.energy.or.kr 로그인 화면 자동입력(사업자번호·휴대폰)과 설치계획서 정보를 구글 시트로 모으는 크롤링 기능.",
  "version": "1.5.0",
  "default_locale": "ko",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://nr.energy.or.kr/*",
    "https://docs.google.com/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "자동입력·크롤링 설정 열기"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://nr.energy.or.kr/*"
      ],
      "all_frames": true,
      "run_at": "document_idle",
      "js": [
        "fill.js",
        "content.js",
        "crawl.js"
      ],
      "css": [
        "content.css"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "data/orgs.json"
      ],
      "matches": [
        "https://nr.energy.or.kr/*"
      ]
    }
  ]
}
